PROJECT_NAME="Multi-IA Consultant"

# Security
SECRET_KEY="VOTRE_SECRET_KEY_A_CHANGER_MIN_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="multiia_db"

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER="openrouter"  # openrouter | ollama | lmstudio

# OpenRouter Configuration (primary cloud provider)
OPENROUTER_API_KEY="sk-or-v1-your-api-key-here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Ollama Configuration
OLLAMA_URL="http://localhost:11434"
OLLAMA_TIMEOUT=120.0
DEFAULT_MODEL_NAME="openai/gpt-4o-mini"

# LM Studio Configuration
LMSTUDIO_BASE_URL="http://localhost:1234"
LMSTUDIO_DEFAULT_MODEL="loaded-model"

# Model Parameters
MODEL_TEMPERATURE=0.7
MODEL_TOP_P=0.9
MODEL_TOP_K=40
MODEL_REPEAT_PENALTY=1.1
MODEL_NUM_PREDICT=1024
MODEL_NUM_CTX=4096
MODEL_SEED=
MODEL_STOP=

# RAG Configuration
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# n8n Research Webhook
N8N_WEBHOOK_URL="http://127.0.0.1:5678/webhook-test/smart-researcher"

# Server and API
DEBUG=False
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
